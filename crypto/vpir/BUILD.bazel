load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "vpir_params",
    srcs = ["vpir_params.cc"],
    hdrs = ["vpir_params.h"],
    deps = [
        "//crypto:encryption",
        "//crypto:polynomial",
        "//crypto:status_macros",
        "//crypto/pir:pir_params",
        "//crypto/proto:pir_cc_proto",
        "@com_google_absl//absl/numeric:bits",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "vpir_params_test",
    srcs = ["vpir_params_test.cc"],
    deps = [
        ":vpir_params",
        "//crypto:encryption",
        "@com_github_google_shell_encryption//shell_encryption/testing:matchers",
        "@com_github_google_shell_encryption//shell_encryption/testing:status_testing",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_googletest//:gtest_main",
    ],
)
